---
import {langs,config,type Lang} from '../../data/config';
import {ui} from '../../data/ui';
import {services} from '../../data/services';
import {publicProjects} from '../../data/projects';
import Artwork from '../../components/Artwork.astro';
import '../../styles/global.css';
import '@fontsource/fraunces/latin-400.css';
import '@fontsource/fraunces/latin-400-italic.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
export function getStaticPaths(){return langs.flatMap(lang=>[undefined,'work','about','services','contact','404',...publicProjects.map(p=>'work/'+p.slug)].map(path=>({params:{lang,path}})));}
const lang=Astro.params.lang as Lang;const path=Astro.params.path||'';const t=ui[lang];const project=publicProjects.find(p=>path==='work/'+p.slug);const c=project?.translations[lang];const url=(p='')=>`/${lang}/${p?p+'/':''}`;const title=project?project.title:path==='404'?t.error:path?t.nav[['work','about','services','contact'].indexOf(path)]:t.title;const description=c?.value||(path==='services'?t.servicesIntro:path==='about'?t.aboutShort:t.intro);const origin=config.origin.replace(/\/$/,'');
---
<!doctype html><html lang={lang==='zh'?'zh-CN':lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} — Betarchivo</title><meta name="description" content={description}/><meta name="theme-color" content="#283B2E"/><meta name="robots" content={config.production&&origin&&path!=='404'?'index,follow':'noindex,nofollow'}/><link rel="icon" href="/favicon.svg"/>{origin&&<><link rel="canonical" href={origin+url(path)}/>{langs.map(l=><link rel="alternate" hreflang={l==='zh'?'zh-CN':l} href={`${origin}/${l}/${path?path+'/':''}`}/>)}<link rel="alternate" hreflang="x-default" href={`${origin}/en/${path?path+'/':''}`}/></>}<meta property="og:title" content={`${title} — Betarchivo`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>{origin&&<><meta property="og:url" content={origin+url(path)}/><meta property="og:image" content={`${origin}/assets/og.png`}/></>}</head><body>
<a class="skip" href="#main">{t.skip}</a><header class="header"><a class="wordmark" href={url()}>betarchivo<span>.</span></a><button class="menu-toggle" aria-expanded="false" aria-controls="navigation" data-open={t.menu} data-close={t.close}><span class="menu-label">{t.menu}</span> <span aria-hidden="true">＋</span></button><nav id="navigation" aria-label={t.menu}><a href={url()} aria-current={!path?'page':undefined}>{t.home}</a>{['work','about','services','contact'].map((p,i)=><a href={url(p)} aria-current={path===p||path.startsWith(p+'/')?'page':undefined}>{t.nav[i]}</a>)}</nav><div class="languages" aria-label={t.langLabel}>{langs.map(l=><a href={`/${l}/${path?path+'/':''}`} lang={l==='zh'?'zh-CN':l} aria-current={lang===l?'true':undefined}>{l==='zh'?'中文':l.toUpperCase()}</a>)}</div></header><main id="main">
{!path&&<><section class="hero hero-studio"><div class="wrap"><div class="hero-top"><span class="eyebrow">{t.eyebrow}</span><span class="issue">BETARCHIVO / 2026 — 001</span></div><div class="hero-grid"><div class="hero-statement"><span class="hero-kicker">DESIGN / DATA / INTERACTION</span><h1>{t.hero[0]}<br/>{t.hero[1]}<br/><em>{t.hero[2]}</em></h1><div class="hero-bottom"><p>{t.intro}</p><div class="actions"><a class="button" href="#selected" data-explore-work>{t.explore} ↘</a><a class="text-link" href={url('contact')}>{t.collaborate} ↗</a></div></div><div class="discipline-tags"><span>01 / DATA & RESEARCH</span><span>02 / INTERACTIVE WEB</span><span>03 / CREATIVE SYSTEMS</span></div></div><div class="hero-drawer-showcase" aria-label="Selected creative disciplines"><div class="hero-showcase-head"><span>BETARCHIVO / OPEN ARCHIVE</span><span>01 — 03</span></div><div class="hero-preview-drawers">{['playground-lab','entre-flores','student-hub-spain'].map((slug,i)=>{const p=publicProjects.find(item=>item.slug===slug)!;return <details class:list={['hero-preview-drawer',`hero-preview-${i}`]} name="hero-preview" open={i===0}><summary><span class="index">0{i+1}</span><span class="drawer-title">{p.title}</span><span class="drawer-plus" aria-hidden="true">+</span></summary><div class="hero-preview-body"><div class="hero-preview-art">{slug==='playground-lab'?<div class="hero-mini-chart"><span class="eyebrow">LIVE MATHEMATICS / DATA STUDY</span><svg viewBox="0 0 500 230" role="img" aria-label="Illustrative function graph"><defs><pattern id="mini-grid" width="25" height="25" patternUnits="userSpaceOnUse"><path d="M25 0H0V25" fill="none" stroke="#a8c2b0" stroke-opacity=".22"/></pattern></defs><rect width="500" height="230" fill="url(#mini-grid)"/><path d="M0 115H500M250 0V230" stroke="#a8c2b0" stroke-opacity=".6"/><path d="M0 118 C45 15 75 10 120 110 S195 230 245 115 S325 0 370 115 S440 225 500 80" stroke="#e7b7b4" fill="none" stroke-width="4"/></svg><span>f(x) · INTERACTIVE SYSTEMS</span></div>:<Artwork project={p} lang={lang}/>}</div><div class="hero-preview-copy"><span class="eyebrow">{t.filters[p.category]} / 2026</span><h3>{p.translations[lang].value}</h3><p>{p.translations[lang].summary}</p><span class="hero-preview-hint">{lang==='zh'?'在下方作品集探索完整项目':lang==='es'?'Explora el proyecto más abajo':'Explore the full project below'} ↓</span></div></div></details>})}</div><span class="hero-showcase-bottom">DATA × DESIGN × DIGITAL EXPERIENCES</span></div></div><div class="hero-foot"><span>{t.identity}</span><span>ART × LOGIC × PLAY</span></div></div></section>
<section class="archive" id="selected"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">01 — {t.collection}</span><h2>{t.selected}</h2></div><p>{t.selectedNote}<br/>{t.open}</p></div><div class="drawers" id="project-drawers">{publicProjects.filter(p=>p.featured).map((p,i)=><details class:list={['drawer',`drawer-${i}`]} name="works" open={i===0}><summary><span class="index">0{i+1}</span><span class="drawer-title">{p.title}</span><span class="drawer-cat">{t.filters[p.category]}</span><span class="drawer-plus" aria-hidden="true">+</span></summary><div class="drawer-body"><Artwork project={p} lang={lang}/><div class="drawer-copy"><span class="eyebrow">{t.filters[p.category]} / {p.year}</span><h3>{p.translations[lang].value}</h3><p>{p.translations[lang].summary}</p><div class="actions"><a class="button light" href={url('work/'+p.slug)}>{t.view} ↗</a>{p.live&&<a class="text-link" href={p.live} target="_blank" rel="noopener noreferrer">{t.live} ↗</a>}</div></div></div></details>)}</div><div class="micro-archive"><div><span class="eyebrow">SMALL IDEAS / 2026</span><h3>Little Experiments</h3></div><div class="micro-links">{publicProjects.filter(p=>!p.featured).map(p=><a href={url('work/'+p.slug)}><span>{p.title}</span><span>↗</span></a>)}</div></div><a class="archive-all" href={url('work')}>{t.all}<span>↗</span></a></div></section>
<section class="wrap capabilities"><div class="section-heading"><div><span class="eyebrow">02 — {t.servicesLabel}</span><h2>{t.capabilities}</h2></div><p>{t.capIntro}</p></div><div class="service-links">{services[lang].map((s,i)=><a href={url('services')+`#service-${i}`}><span class="index">0{i+1}</span><div><h3>{s[0]}</h3><p>{s[1]}</p></div><span>↗</span></a>)}</div></section><section class="about-strip wrap"><span class="eyebrow">03 — {t.aboutLabel}</span><h2>{t.aboutTitle}</h2><div><p>{t.aboutShort}</p><a class="text-link" href={url('about')}>{t.aboutMore} ↗</a></div></section></>}
{path==='work'&&<section class="wrap page"><span class="eyebrow">{t.collection}</span><h1 class="page-title">{t.workTitle}</h1><p class="lead">{t.workIntro}</p><div class="filters" role="group" aria-label={t.nav[0]}>{[0,4,2,1,3].map(i=><button data-filter={i} aria-pressed={i===0?'true':'false'}>{t.filters[i]}</button>)}</div><div class="work-grid">{publicProjects.map(p=><article class="work-card" data-category={p.category}><a href={url('work/'+p.slug)} aria-label={`${t.view}: ${p.title}`}><Artwork project={p} lang={lang}/><div class="card-top"><span>{t.filters[p.category]}</span><span>↗</span></div><h2>{p.title}</h2><p>{p.translations[lang].value}</p><span class="text-link">{t.view} ↗</span></a></article>)}</div><p id="empty" hidden role="status">{t.empty}</p><p id="results" class="sr-only" aria-live="polite" data-unit={t.count}></p></section>}
{project&&c&&<article class="wrap page case"><a class="back" href={url('work')}>← {t.back}</a><div class="case-heading"><div><span class="eyebrow">{t.filters[project.category]} / {project.year}</span><h1>{project.title}</h1><p class="lead">{c.value}</p></div><div><span class="status">{project.status==='live'?(lang==='zh'?'已上线':lang==='es'?'Publicado':'Live'):t.status}</span><div class="actions">{project.live&&<a class="button" href={project.live} target="_blank" rel="noopener noreferrer">{t.live} ↗</a>}{project.repository&&<a class="text-link" href={project.repository} target="_blank" rel="noopener noreferrer">{t.repo} ↗</a>}</div></div></div><Artwork project={project} lang={lang} eager/>{project.slug==='entre-flores'&&<section class="floral-case-gallery" aria-label={lang==='zh'?'项目画廊':lang==='es'?'Galería del proyecto':'Project gallery'}>{[
{src:'/assets/entre-flores-spring.webp',title:{en:'A Garden Through the Seasons',es:'Un jardín a través de las estaciones',zh:'四季流转的花园'},body:{en:'Explore a living botanical world, where each season brings a different mood and flowers invite closer discovery.',es:'Explora un mundo botánico vivo: cada estación tiene su propia atmósfera y cada flor invita a descubrir más.',zh:'探索随季节变换的植物世界。不同的光影与花材，呈现四季各自的氛围。'}},
{src:'/assets/entre-flores-autumn.webp',title:{en:'Discover the Details',es:'Descubre los detalles',zh:'发现花朵的故事'},body:{en:'Select a flower to open its botanical card, with details, seasonal notes and pairing ideas.',es:'Selecciona una flor para descubrir su ficha botánica, detalles de temporada y sugerencias para combinarla.',zh:'点击花朵打开植物介绍卡，了解花材、季节信息和搭配灵感。'}},
{src:'/assets/entre-flores-builder.webp',title:{en:'Create Your Bouquet',es:'Crea tu ramo',zh:'亲手创作一束花'},body:{en:'Choose flowers, arrange stems and experiment with wrapping and vessels in an interactive bouquet editor.',es:'Elige flores, coloca los tallos y prueba envoltorios y recipientes en un editor interactivo.',zh:'选择花材、调整花枝、尝试包装和花器，在交互编辑器里创作自己的花束。'}},
{src:'/assets/entre-flores-creations.webp',title:{en:'Curated Floral Creations',es:'Creaciones florales',zh:'花束灵感收藏'},body:{en:'An editorial collection of floral compositions brings the atelier’s visual identity into every detail.',es:'Una colección editorial de composiciones florales que refleja la identidad visual del atelier.',zh:'通过编辑式排版和花束作品展示，让花艺工作室的视觉语言贯穿整个体验。'}}
].map((item,i)=><figure class="floral-gallery-item"><div class="floral-gallery-heading"><span>0{i+1} / 04</span><div><h2>{item.title[lang]}</h2><p>{item.body[lang]}</p></div></div><img src={item.src} alt={`${project.title} — ${item.title[lang]}`} loading="lazy" width="1600" height="900"/></figure>)}</section>}<div class="case-columns"><aside><span class="eyebrow">{t.role}</span><p>{c.role}</p><span class="eyebrow">{t.details}</span><p>{project.year}<br/>{t.filters[project.category]}</p></aside><div><section><h2>{t.overview}</h2><p>{c.summary}</p>{c.objectives.map(x=><p>{x}</p>)}</section><section><h2>{t.experience}</h2><ul>{c.features.map(x=><li>{x}</li>)}</ul></section><section><h2>{t.process}</h2>{[...c.process,...c.challenges].map(x=><p>{x}</p>)}</section><section class="scope"><h2>{t.limits}</h2>{c.outcomes.map(x=><p>{x}</p>)}</section><a class="button" href={url('contact')+'?project='+project.slug}>{t.inquiry} ↗</a></div></div><div class="related"><h2>{t.related}</h2>{publicProjects.filter(p=>p.slug!==project.slug).map(p=><a href={url('work/'+p.slug)}>{p.title} ↗</a>)}</div></article>}
{path==='services'&&<section class="wrap page"><span class="eyebrow">{t.servicesLabel}</span><h1 class="page-title">{t.servicesTitle}</h1><p class="lead">{t.servicesIntro}</p><div class="services-list">{services[lang].map((s,i)=><article id={`service-${i}`}><span class="index">0{i+1}</span><div><h2>{s[0]}</h2><p class="lead">{s[1]}</p></div><div><h3>{t.for}</h3><p>{s[2]}</p><h3>{t.value}</h3><p>{s[3]}</p>{s[4]&&<a class="text-link" href={url('work/'+s[4])}>{t.example} ↗</a>}<a class="service-inquiry" href={url('contact')}>{t.inquire} ↗</a></div></article>)}</div><div class="process"><h2>{t.approach}</h2><ol>{t.steps.map(s=><li>{s}</li>)}</ol></div></section>}
{path==='about'&&<section class="wrap page"><span class="eyebrow">{t.aboutLabel}</span><h1 class="page-title">{t.aboutTitle}</h1><div class="about-grid"><div class="monogram" aria-hidden="true">b<span>✳</span><small>BETARCHIVO / 2026</small></div><div><p class="lead">{t.aboutShort}</p><p>{t.aboutBody}</p><hr/><p>{t.aboutStudy}</p><p>{t.languages}</p><p>{t.interests}</p><hr/><h2>Metamorphosis</h2><p>{t.method}</p><a class="text-link" href={url('work')}>{t.explore} ↗</a></div></div></section>}
{path==='contact'&&<section class="wrap page contact-page"><span class="eyebrow">{t.contactLabel}</span><h1 class="page-title">{t.contactTitle}</h1><p class="lead">{t.contactIntro}</p><p id="inquiry-context" hidden>{t.context}: <strong></strong></p><div class="contact-box">{config.contact.email?<a class="button" id="email" href={'mailto:'+config.contact.email}>{t.send} ↗</a>:<><span class="contact-dot"></span><h2>{t.contactUnavailable}</h2><p>{t.contactNote}</p></>}<a class="text-link" href={url('work')}>{t.explore} ↗</a>{config.contact.socials.map(s=><a href={s.url} rel="noopener noreferrer">{s.label}</a>)}</div></section>}
{path==='404'&&<section class="wrap page"><h1 class="page-title">404<br/>{t.error}</h1><a class="button" href={url()}>{t.home} ↗</a></section>}
{path!=='contact'&&path!=='404'&&<section class="contact-banner"><div class="wrap"><span class="eyebrow">{t.contactLabel}</span><a href={url('contact')}><h2>{t.contactTitle}</h2><span>↗</span></a></div></section>}</main><footer class="wrap"><a class="wordmark" href={url()}>betarchivo.</a><p>{t.footer}</p><div><span>© 2026 Betarchivo</span><span>{t.privacy}</span></div></footer>
<script>
const exploreLink=document.querySelector<HTMLAnchorElement>('[data-explore-work]');
exploreLink?.addEventListener('click',event=>{const target=document.getElementById('project-drawers');if(!target)return;event.preventDefault();history.replaceState(null,'','#selected');const top=target.getBoundingClientRect().top+window.scrollY-12;window.scrollTo({top,behavior:'smooth'});});
const graph=document.querySelector<HTMLElement>('[data-graph]');const param=document.querySelector<HTMLInputElement>('[data-graph-param]');const output=document.querySelector<HTMLOutputElement>('[data-graph-value]');
if(graph&&param){const svg=graph.querySelector('svg')!;const curve=graph.querySelector<SVGPathElement>('[data-curve]')!;const dots=graph.querySelector<SVGGElement>('[data-dots]')!;const crossX=graph.querySelector<SVGLineElement>('[data-cross-x]')!;const crossY=graph.querySelector<SVGLineElement>('[data-cross-y]')!;const cursor=graph.querySelector<SVGCircleElement>('[data-cursor]')!;const tooltip=graph.querySelector<HTMLElement>('[data-graph-tooltip]')!;const f=(x:number)=>Math.sin(Number(param.value)*x)*Math.cos(x/2);const xFor=(px:number)=>(px/500)*12-6;const yFor=(y:number)=>170-y*100;function draw(){const points=Array.from({length:251},(_,i)=>{const px=i*2;return `${i?'L':'M'}${px.toFixed(1)},${yFor(f(xFor(px))).toFixed(2)}`}).join(' ');curve.setAttribute('d',points);dots.innerHTML='';for(let i=0;i<9;i++){const px=35+i*54;const cy=yFor(f(xFor(px)));const dot=document.createElementNS('http://www.w3.org/2000/svg','circle');dot.setAttribute('cx',String(px));dot.setAttribute('cy',String(cy));dot.setAttribute('r','3.5');dot.setAttribute('fill','#e4b2ac');dots.append(dot)}if(output)output.value=Number(param.value).toFixed(1)}function probe(clientX:number){const rect=svg.getBoundingClientRect();const px=Math.max(0,Math.min(500,(clientX-rect.left)/rect.width*500));const x=xFor(px),y=f(x),py=yFor(y);crossX.setAttribute('x1',String(px));crossX.setAttribute('x2',String(px));crossY.setAttribute('y1',String(py));crossY.setAttribute('y2',String(py));cursor.setAttribute('cx',String(px));cursor.setAttribute('cy',String(py));for(const el of [crossX,crossY,cursor])el.setAttribute('opacity','1');tooltip.textContent=`x ${x.toFixed(2)}   /   y ${y.toFixed(3)}`}svg.addEventListener('pointermove',e=>probe(e.clientX));svg.addEventListener('pointerdown',e=>probe(e.clientX));svg.addEventListener('pointerleave',()=>{for(const el of [crossX,crossY,cursor])el.setAttribute('opacity','0');tooltip.textContent='MOVE / TAP TO EXPLORE'});param.addEventListener('input',draw);draw()}
const toggle=document.querySelector<HTMLButtonElement>('.menu-toggle');const nav=document.querySelector('nav');
function setMenu(open:boolean){toggle?.setAttribute('aria-expanded',String(open));nav?.classList.toggle('visible',open);const label=toggle?.querySelector('.menu-label');if(label)label.textContent=toggle?.dataset[open?'close':'open']||'';}
toggle?.addEventListener('click',()=>setMenu(toggle.getAttribute('aria-expanded')!=='true'));
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&toggle?.getAttribute('aria-expanded')==='true'){setMenu(false);toggle.focus();}});
const filters=document.querySelectorAll<HTMLButtonElement>('[data-filter]');function applyFilter(value:string){let count=0;filters.forEach(f=>f.setAttribute('aria-pressed',String(f.dataset.filter===value)));document.querySelectorAll<HTMLElement>('[data-category]').forEach(card=>{card.hidden=value!=='0'&&card.dataset.category!==value;if(!card.hidden)count++;});const empty=document.querySelector<HTMLElement>('#empty');if(empty)empty.hidden=count!==0;const results=document.querySelector('#results');if(results)results.textContent=`${count} ${results.getAttribute('data-unit')}`;}
filters.forEach(b=>b.addEventListener('click',()=>{const value=b.dataset.filter||'0';applyFilter(value);const u=new URL(location.href);if(value==='0')u.searchParams.delete('category');else u.searchParams.set('category',value);history.replaceState(null,'',u);}));
const query=new URLSearchParams(location.search);if(filters.length)applyFilter(['0','1','2','3','4'].includes(query.get('category')||'')?query.get('category')!:'0');
const slug=query.get('project');const names:Record<string,string>={'entre-flores':'ENTRE FLORES','student-hub-spain':'Student Hub Spain','interactive-phone':'Interactive Phone Simulator','merge-game':'Merge Game','squish-toy':'Squish Toy'};if(slug&&names[slug]){const context=document.querySelector<HTMLElement>('#inquiry-context');if(context){context.hidden=false;context.querySelector('strong')!.textContent=names[slug];}const email=document.querySelector<HTMLAnchorElement>('#email');if(email)email.href+='?subject='+encodeURIComponent('Project enquiry: '+names[slug]);}
document.querySelectorAll<HTMLAnchorElement>('.languages a').forEach(a=>{a.addEventListener('click',()=>{const params=new URLSearchParams(location.search);const safe=new URLSearchParams();if(slug&&names[slug])safe.set('project',slug);if(filters.length&&params.has('category'))safe.set('category',params.get('category')!);a.search=safe.toString();});});
</script></body></html>
