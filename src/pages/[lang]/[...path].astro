---
import {langs,config,type Lang} from '../../data/config';
import {ui} from '../../data/ui';
import {services} from '../../data/services';
import {publicProjects} from '../../data/projects';
import Artwork from '../../components/Artwork.astro';
import ArchiveCabinet from '../../components/archive/ArchiveCabinet.astro';
import {archiveCopy} from '../../data/archive';
import SketchArrow from '../../components/SketchArrow.astro';
import '../../styles/global.css';
import '@fontsource/fraunces/latin-400.css';
import '@fontsource/fraunces/latin-400-italic.css';
import '@fontsource/dm-sans/latin-400.css';
import '@fontsource/dm-sans/latin-500.css';
export function getStaticPaths(){return langs.flatMap(lang=>[undefined,'work','about','services','contact','404',...publicProjects.map(p=>'work/'+p.slug)].map(path=>({params:{lang,path}})));}
const lang=Astro.params.lang as Lang;const path=Astro.params.path||'';const t=ui[lang];const project=publicProjects.find(p=>path==='work/'+p.slug);const c=project?.translations[lang];const url=(p='')=>`/${lang}/${p?p+'/':''}`;const title=project?project.title:path==='404'?t.error:path?t.nav[['work','about','services','contact'].indexOf(path)]:t.title;const description=c?.value||(path==='services'?t.servicesIntro:path==='about'?t.aboutShort:t.intro);const origin=config.origin.replace(/\/$/,'');
---
<!doctype html><html lang={lang==='zh'?'zh-CN':lang}><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title} — Betarchivo</title><meta name="description" content={description}/><meta name="theme-color" content="#283B2E"/><meta name="robots" content={config.production&&origin&&path!=='404'?'index,follow':'noindex,nofollow'}/><link rel="icon" href="/favicon.svg"/>{origin&&<><link rel="canonical" href={origin+url(path)}/>{langs.map(l=><link rel="alternate" hreflang={l==='zh'?'zh-CN':l} href={`${origin}/${l}/${path?path+'/':''}`}/>)}<link rel="alternate" hreflang="x-default" href={`${origin}/en/${path?path+'/':''}`}/></>}<meta property="og:title" content={`${title} — Betarchivo`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>{origin&&<><meta property="og:url" content={origin+url(path)}/><meta property="og:image" content={`${origin}/assets/og.png`}/></>}</head><body>
<a class="skip" href="#main">{t.skip}</a><header class="header"><a class="wordmark" href={url()}>betarchivo<span>.</span></a><button class="menu-toggle" aria-expanded="false" aria-controls="navigation" data-open={t.menu} data-close={t.close}><span class="menu-label">{t.menu}</span> <span aria-hidden="true">＋</span></button><nav id="navigation" aria-label={t.menu}><a href={url()} aria-current={!path?'page':undefined}>{t.home}</a>{['work','about','services','contact'].map((p,i)=><a href={url(p)} aria-current={path===p||path.startsWith(p+'/')?'page':undefined}>{t.nav[i]}</a>)}</nav><div class="languages" aria-label={t.langLabel}>{langs.map(l=><a href={`/${l}/${path?path+'/':''}`} lang={l==='zh'?'zh-CN':l} aria-current={lang===l?'true':undefined}>{l==='zh'?'中文':l.toUpperCase()}</a>)}</div></header><main id="main">
{!path&&<><ArchiveCabinet lang={lang}/>
<section class="archive" id="selected"><div class="wrap"><div class="section-heading"><div><span class="eyebrow">01 — {t.collection}</span><h2>{t.selected}</h2></div><p>{t.selectedNote}<br/>{t.open}</p></div><div class="drawers" id="project-drawers">{publicProjects.filter(p=>p.featured).map((p,i)=><details class:list={['drawer',`drawer-${i}`]} name="works"><summary><span class="index">0{i+1}</span><span class="drawer-title">{p.title}</span><span class="drawer-cat">{t.filters[p.category]}</span><span class="drawer-plus" aria-hidden="true">+</span></summary><div class="drawer-body"><Artwork project={p} lang={lang}/><div class="drawer-copy"><span class="eyebrow">{t.filters[p.category]} / {p.year}</span><h3>{p.translations[lang].value}</h3><p>{p.translations[lang].summary}</p><div class="actions"><a class="button light" href={url('work/'+p.slug)}>{t.view} <SketchArrow direction="up-right"/></a>{p.live&&<a class="text-link" href={p.live} target="_blank" rel="noopener noreferrer">{t.live} <SketchArrow direction="up-right"/></a>}</div></div></div></details>)}</div><div class="micro-archive"><div><span class="eyebrow">SMALL IDEAS / 2026</span><h3>Little Experiments</h3></div><div class="micro-links">{publicProjects.filter(p=>!p.featured).map(p=><a href={url('work/'+p.slug)}><span>{p.title}</span><span><SketchArrow direction="up-right"/></span></a>)}</div></div><a class="archive-all" href={url('work')}>{t.all}<span><SketchArrow direction="up-right"/></span></a></div></section>
<section class="wrap capabilities"><div class="section-heading"><div><span class="eyebrow">02 — {t.servicesLabel}</span><h2>{t.capabilities}</h2></div><p>{t.capIntro}</p></div><div class="service-links">{services[lang].map((s,i)=><a href={url('services')+`#service-${i}`}><span class="index">0{i+1}</span><div><h3>{s[0]}</h3><p>{s[1]}</p></div><span><SketchArrow direction="up-right"/></span></a>)}</div></section><section class="about-strip wrap"><span class="eyebrow">03 — {t.aboutLabel}</span><h2>{t.aboutTitle}</h2><div><p>{t.aboutShort}</p><a class="text-link" href={url('about')}>{t.aboutMore} <SketchArrow direction="up-right"/></a></div></section></>}
{path==='work'&&<section class="wrap page"><span class="eyebrow">{t.collection}</span><h1 class="page-title">{t.workTitle}</h1><p class="lead">{t.workIntro}</p><div class="filters" role="group" aria-label={t.nav[0]}>{[0,4,2,1,3].map(i=><button data-filter={i} aria-pressed={i===0?'true':'false'}>{t.filters[i]}</button>)}</div><div class="work-grid">{publicProjects.map(p=><article class="work-card" data-category={p.category}><a href={url('work/'+p.slug)} aria-label={`${t.view}: ${p.title}`}><Artwork project={p} lang={lang}/><div class="card-top"><span>{t.filters[p.category]}</span><span><SketchArrow direction="up-right"/></span></div><h2>{p.title}</h2><p>{p.translations[lang].value}</p><span class="text-link">{t.view} <SketchArrow direction="up-right"/></span></a></article>)}</div><p id="empty" hidden role="status">{t.empty}</p><p id="results" class="sr-only" aria-live="polite" data-unit={t.count}></p></section>}
{project&&c&&<article class="wrap page case"><a class="back" href={url()+'#archive'}>{archiveCopy[lang].return}</a><a class="back" href={url('work')}><SketchArrow direction="left"/> {t.back}</a><div class="case-heading"><div><span class="eyebrow">{t.filters[project.category]} / {project.year}</span><h1>{project.title}</h1><p class="lead">{c.value}</p></div><div><span class="status">{t.status}</span><div class="actions">{project.live&&<a class="button" href={project.live} target="_blank" rel="noopener noreferrer">{t.live} <SketchArrow direction="up-right"/></a>}{project.repository&&<a class="text-link" href={project.repository} target="_blank" rel="noopener noreferrer">{t.repo} <SketchArrow direction="up-right"/></a>}</div></div></div><Artwork project={project} lang={lang} eager/>
{project.slug==='entre-flores'&&project.gallery?.length>0&&<section class="floral-case-story" aria-label="ENTRE FLORES — visual case study">
  {[
    {src:project.gallery[0],number:'01 / 04',title:lang==='zh'?'四季花园':lang==='es'?'Un jardín a través de las estaciones':'A Garden Through the Seasons',description:lang==='zh'?'探索会随季节变化的花园。每个季节都有独特的光线、色彩与花材，邀请访客走近花朵。':lang==='es'?'Un jardín vivo que cambia de luz, color y flores con cada estación.':'Explore a living botanical world, where each season brings a different mood and flowers invite closer discovery.'},
    {src:project.gallery[1],number:'02 / 04',title:lang==='zh'?'秋日的另一种色彩':lang==='es'?'El jardín en otoño':'The Garden in Autumn',description:lang==='zh'?'从春日柔和的粉色，到秋季大丽花与金色光影，四季切换成为作品的一部分。':lang==='es'?'De los tonos suaves de primavera a las dalias y la luz dorada del otoño.':'From soft spring blossoms to autumn dahlias and golden light, each season creates a different atmosphere.'},
    {src:project.gallery[3],number:'03 / 04',title:lang==='zh'?'花束与灵感':lang==='es'?'Nuestros ramos':'Floral Compositions',description:lang==='zh'?'以花束作品、色彩与材质构成一份可探索的花艺收藏。':lang==='es'?'Composiciones de temporada que hablan por sí solas, reunidas para inspirar.':'Seasonal floral compositions gathered to inspire, with color, texture and a distinctive editorial presentation.'},
    {src:project.gallery[2],number:'04 / 04',title:lang==='zh'?'亲手创作花束':lang==='es'?'Crea tu ramo':'Build Your Own Bouquet',description:lang==='zh'?'访客可以挑选花材、花瓶与包装，在交互工作台中自由组合，实时查看自己的花束。':lang==='es'?'Elige flores, jarrones y envoltorios y crea una composición personal en el atelier interactivo.':'Choose flowers, vessels and wrapping, then arrange a personal bouquet in the interactive atelier.'}
  ].map(item=><section class="floral-story-chapter"><div class="floral-story-heading"><span class="eyebrow">{item.number}</span><div><h2>{item.title}</h2><p>{item.description}</p></div></div><figure><img src={item.src} alt={`${project.title} — ${item.title}`} loading="lazy" decoding="async" width="1600" height="900"/></figure></section>)}
  <a class="floral-story-visit" href={project.live!} target="_blank" rel="noopener noreferrer">{lang==='zh'?'探索 ENTRE FLORES 互动网站':lang==='es'?'Explorar la experiencia interactiva':'Explore the interactive floral atelier'} <SketchArrow direction="up-right"/></a>
</section>}
{project.slug!=='entre-flores'&&project.gallery?.length>0&&<section class="project-gallery" aria-label={project.title+' — gallery'}>{project.gallery.map((src,i)=><figure class="project-gallery-item"><img src={src} alt={`${project.title} — screenshot ${i+1}`} loading="lazy" decoding="async" width="1600" height="900"/></figure>)}</section>}
<div class="case-columns"><aside><span class="eyebrow">{t.role}</span><p>{c.role}</p><span class="eyebrow">{t.details}</span><p>{project.year}<br/>{t.filters[project.category]}</p></aside><div><section><h2>{t.overview}</h2><p>{c.summary}</p>{c.objectives.map(x=><p>{x}</p>)}</section><section><h2>{t.experience}</h2><ul>{c.features.map(x=><li>{x}</li>)}</ul></section><section><h2>{t.process}</h2>{[...c.process,...c.challenges].map(x=><p>{x}</p>)}</section><section class="scope"><h2>{t.limits}</h2>{c.outcomes.map(x=><p>{x}</p>)}</section><a class="button" href={url('contact')+'?project='+project.slug}>{t.inquiry} <SketchArrow direction="up-right"/></a></div></div><div class="related"><h2>{t.related}</h2>{publicProjects.filter(p=>p.slug!==project.slug).map(p=><a href={url('work/'+p.slug)}>{p.title} <SketchArrow direction="up-right"/></a>)}</div></article>}
{path==='services'&&<section class="wrap page"><span class="eyebrow">{t.servicesLabel}</span><h1 class="page-title">{t.servicesTitle}</h1><p class="lead">{t.servicesIntro}</p><div class="services-list">{services[lang].map((s,i)=><article id={`service-${i}`}><span class="index">0{i+1}</span><div><h2>{s[0]}</h2><p class="lead">{s[1]}</p></div><div><h3>{t.for}</h3><p>{s[2]}</p><h3>{t.value}</h3><p>{s[3]}</p>{s[4]&&<a class="text-link" href={url('work/'+s[4])}>{t.example} <SketchArrow direction="up-right"/></a>}<a class="service-inquiry" href={url('contact')}>{t.inquire} <SketchArrow direction="up-right"/></a></div></article>)}</div><div class="process"><h2>{t.approach}</h2><ol>{t.steps.map(s=><li>{s}</li>)}</ol></div></section>}
{path==='about'&&<section class="wrap page"><span class="eyebrow">{t.aboutLabel}</span><h1 class="page-title">{t.aboutTitle}</h1><div class="about-grid"><div class="monogram" aria-hidden="true">b<span>✳</span><small>BETARCHIVO / 2026</small></div><div><p class="lead">{t.aboutShort}</p><p>{t.aboutBody}</p><hr/><p>{t.aboutStudy}</p><p>{t.languages}</p><p>{t.interests}</p><hr/><h2>Metamorphosis</h2><p>{t.method}</p><a class="text-link" href={url('work')}>{t.explore} <SketchArrow direction="up-right"/></a></div></div></section>}
{path==='contact'&&<section class="wrap page contact-page"><span class="eyebrow">{t.contactLabel}</span><h1 class="page-title">{t.contactTitle}</h1><p class="lead">{t.contactIntro}</p><p id="inquiry-context" hidden>{t.context}: <strong></strong></p><div class="contact-box">{config.contact.email?<a class="button" id="email" href={'mailto:'+config.contact.email}>{t.send} <SketchArrow direction="up-right"/></a>:<><span class="contact-dot"></span><h2>{t.contactUnavailable}</h2><p>{t.contactNote}</p></>}<a class="text-link" href={url('work')}>{t.explore} <SketchArrow direction="up-right"/></a>{config.contact.socials.map(s=><a href={s.url} rel="noopener noreferrer">{s.label}</a>)}</div></section>}
{path==='404'&&<section class="wrap page"><h1 class="page-title">404<br/>{t.error}</h1><a class="button" href={url()}>{t.home} <SketchArrow direction="up-right"/></a></section>}
{path!=='contact'&&path!=='404'&&<section class="contact-banner"><div class="wrap"><span class="eyebrow">{t.contactLabel}</span><a href={url('contact')}><h2>{t.contactTitle}</h2><span><SketchArrow direction="up-right"/></span></a></div></section>}</main><footer class="wrap"><a class="wordmark" href={url()}>betarchivo.</a><p>{t.footer}</p><div><span>© 2026 Betarchivo</span><span>{t.privacy}</span></div></footer>
<script>
const exploreLink=document.querySelector<HTMLAnchorElement>('[data-explore-work]');
exploreLink?.addEventListener('click',event=>{const target=document.getElementById('selected');if(!target)return;event.preventDefault();history.replaceState(null,'','#selected');const top=target.getBoundingClientRect().top+window.scrollY-96;window.scrollTo({top,behavior:'smooth'});});
const graph=document.querySelector<HTMLElement>('[data-graph]');const param=document.querySelector<HTMLInputElement>('[data-graph-param]');const output=document.querySelector<HTMLOutputElement>('[data-graph-value]');
if(graph&&param){const svg=graph.querySelector('svg')!;const curve=graph.querySelector<SVGPathElement>('[data-curve]')!;const dots=graph.querySelector<SVGGElement>('[data-dots]')!;const crossX=graph.querySelector<SVGLineElement>('[data-cross-x]')!;const crossY=graph.querySelector<SVGLineElement>('[data-cross-y]')!;const cursor=graph.querySelector<SVGCircleElement>('[data-cursor]')!;const tooltip=graph.querySelector<HTMLElement>('[data-graph-tooltip]')!;const f=(x:number)=>Math.sin(Number(param.value)*x)*Math.cos(x/2);const xFor=(px:number)=>(px/500)*12-6;const yFor=(y:number)=>170-y*100;function draw(){const points=Array.from({length:251},(_,i)=>{const px=i*2;return `${i?'L':'M'}${px.toFixed(1)},${yFor(f(xFor(px))).toFixed(2)}`}).join(' ');curve.setAttribute('d',points);dots.innerHTML='';for(let i=0;i<9;i++){const px=35+i*54;const cy=yFor(f(xFor(px)));const dot=document.createElementNS('http://www.w3.org/2000/svg','circle');dot.setAttribute('cx',String(px));dot.setAttribute('cy',String(cy));dot.setAttribute('r','3.5');dot.setAttribute('fill','#e4b2ac');dots.append(dot)}if(output)output.value=Number(param.value).toFixed(1)}function probe(clientX:number){const rect=svg.getBoundingClientRect();const px=Math.max(0,Math.min(500,(clientX-rect.left)/rect.width*500));const x=xFor(px),y=f(x),py=yFor(y);crossX.setAttribute('x1',String(px));crossX.setAttribute('x2',String(px));crossY.setAttribute('y1',String(py));crossY.setAttribute('y2',String(py));cursor.setAttribute('cx',String(px));cursor.setAttribute('cy',String(py));for(const el of [crossX,crossY,cursor])el.setAttribute('opacity','1');tooltip.textContent=`x ${x.toFixed(2)}   /   y ${y.toFixed(3)}`}svg.addEventListener('pointermove',e=>probe(e.clientX));svg.addEventListener('pointerdown',e=>probe(e.clientX));svg.addEventListener('pointerleave',()=>{for(const el of [crossX,crossY,cursor])el.setAttribute('opacity','0');tooltip.textContent='MOVE / TAP TO EXPLORE'});param.addEventListener('input',draw);draw()}
const toggle=document.querySelector<HTMLButtonElement>('.menu-toggle');const nav=document.querySelector('nav');
function setMenu(open:boolean){toggle?.setAttribute('aria-expanded',String(open));nav?.classList.toggle('visible',open);const label=toggle?.querySelector('.menu-label');if(label)label.textContent=toggle?.dataset[open?'close':'open']||'';}
toggle?.addEventListener('click',()=>setMenu(toggle.getAttribute('aria-expanded')!=='true'));
document.addEventListener('keydown',e=>{if(e.key==='Escape'&&toggle?.getAttribute('aria-expanded')==='true'){setMenu(false);toggle.focus();}});
const filters=document.querySelectorAll<HTMLButtonElement>('[data-filter]');function applyFilter(value:string){let count=0;filters.forEach(f=>f.setAttribute('aria-pressed',String(f.dataset.filter===value)));document.querySelectorAll<HTMLElement>('[data-category]').forEach(card=>{card.hidden=value!=='0'&&card.dataset.category!==value;if(!card.hidden)count++;});const empty=document.querySelector<HTMLElement>('#empty');if(empty)empty.hidden=count!==0;const results=document.querySelector('#results');if(results)results.textContent=`${count} ${results.getAttribute('data-unit')}`;}
filters.forEach(b=>b.addEventListener('click',()=>{const value=b.dataset.filter||'0';applyFilter(value);const u=new URL(location.href);if(value==='0')u.searchParams.delete('category');else u.searchParams.set('category',value);history.replaceState(null,'',u);}));
const query=new URLSearchParams(location.search);if(filters.length)applyFilter(['0','1','2','3','4'].includes(query.get('category')||'')?query.get('category')!:'0');
const slug=query.get('project');const names:Record<string,string>={'entre-flores':'ENTRE FLORES','student-hub-spain':'Student Hub Spain','interactive-phone':'Interactive Phone Simulator','merge-game':'Merge Game','squish-toy':'Squish Toy'};if(slug&&names[slug]){const context=document.querySelector<HTMLElement>('#inquiry-context');if(context){context.hidden=false;context.querySelector('strong')!.textContent=names[slug];}const email=document.querySelector<HTMLAnchorElement>('#email');if(email)email.href+='?subject='+encodeURIComponent('Project enquiry: '+names[slug]);}
document.querySelectorAll<HTMLAnchorElement>('.languages a').forEach(a=>{a.addEventListener('click',()=>{const params=new URLSearchParams(location.search);const safe=new URLSearchParams();if(slug&&names[slug])safe.set('project',slug);if(filters.length&&params.has('category'))safe.set('category',params.get('category')!);a.search=safe.toString();});});
</script></body></html>
